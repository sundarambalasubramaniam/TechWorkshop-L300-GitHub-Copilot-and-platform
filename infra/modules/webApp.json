{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.39.26.7824",
      "templateHash": "9161615200813174938"
    }
  },
  "parameters": {
    "webAppName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Web App"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for the Web App"
      }
    },
    "appServicePlanId": {
      "type": "string",
      "metadata": {
        "description": "App Service Plan resource ID"
      }
    },
    "acrLoginServer": {
      "type": "string",
      "metadata": {
        "description": "ACR login server URL"
      }
    },
    "dockerImageTag": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "Docker image name and tag"
      }
    },
    "appInsightsConnectionString": {
      "type": "string",
      "metadata": {
        "description": "Application Insights Connection String"
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Tags to apply to the Web App"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "[parameters('webAppName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux,container",
      "tags": "[parameters('tags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[parameters('appServicePlanId')]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "[format('DOCKER|{0}/zava-storefront:{1}', parameters('acrLoginServer'), parameters('dockerImageTag'))]",
          "acrUseManagedIdentityCreds": true,
          "appSettings": [
            {
              "name": "WEBSITES_ENABLE_APP_SERVICE_STORAGE",
              "value": "false"
            },
            {
              "name": "DOCKER_REGISTRY_SERVER_URL",
              "value": "[format('https://{0}', parameters('acrLoginServer'))]"
            },
            {
              "name": "WEBSITES_PORT",
              "value": "8080"
            },
            {
              "name": "ASPNETCORE_ENVIRONMENT",
              "value": "Production"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[parameters('appInsightsConnectionString')]"
            },
            {
              "name": "ApplicationInsightsAgent_EXTENSION_VERSION",
              "value": "~3"
            },
            {
              "name": "XDT_MicrosoftApplicationInsights_Mode",
              "value": "recommended"
            }
          ],
          "alwaysOn": false,
          "http20Enabled": true,
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled"
        }
      }
    }
  ],
  "outputs": {
    "principalId": {
      "type": "string",
      "metadata": {
        "description": "Web App principal ID (managed identity)"
      },
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2023-01-01', 'full').identity.principalId]"
    },
    "defaultHostname": {
      "type": "string",
      "metadata": {
        "description": "Web App default hostname"
      },
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2023-01-01').defaultHostName]"
    },
    "webAppId": {
      "type": "string",
      "metadata": {
        "description": "Web App resource ID"
      },
      "value": "[resourceId('Microsoft.Web/sites', parameters('webAppName'))]"
    },
    "webAppName": {
      "type": "string",
      "metadata": {
        "description": "Web App name"
      },
      "value": "[parameters('webAppName')]"
    }
  }
}